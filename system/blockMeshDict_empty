FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

xmin -1.0;      xmax 5.0;      dx 0.02;
ymin  0.06;     ymax 0.08;      dy 0.02;
zmin  0.0;      zmax 0.8;       dz 0.02;

Nx #eval { floor( ($xmax + (-1)*$xmin) / $dx ) };
Ny #eval { floor( ($ymax + (-1)*$ymin) / $dy ) };
Nz #eval { floor( ($zmax + (-1)*$zmin) / $dz ) };

vertices
(
    ($xmin $ymin $zmin)
    ($xmax $ymin $zmin)
    ($xmax $ymax $zmin)
    ($xmin $ymax $zmin)
    ($xmin $ymin $zmax)
    ($xmax $ymin $zmax)
    ($xmax $ymax $zmax)
    ($xmin $ymax $zmax)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($Nx $Ny $Nz) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (1 5 6 2)
        );
    }
	top
    {
        type patch;
        faces
        (
            (4 5 6 7)
        );
    }
    bottom
    {
        type wall;
        faces
        (
            (0 1 2 3)
        );
    }
    back
    {
        type cyclic;
        neighbourPatch front;
        faces
        (
            (3 2 6 7)
        );
    }
    front
    {
        type cyclic;
        neighbourPatch back;
        faces
        (
            (0 1 5 4)
        );
    }
);

mergePatchPairs
(
);


