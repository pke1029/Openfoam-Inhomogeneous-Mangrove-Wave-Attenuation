FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          refineMeshDict;
}

set             interface_region2;

coordinateSystem global;

globalCoeffs
{
    tan1            ( 1 0 0 );
    tan2            ( 0 1 0 );
}

directions      ( normal );

useHexTopology  true;

geometricCut    false;

writeMesh       false;


